# Database - PostgreSQL instance
DATABASE_URL=""

# GitHub OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# JWT Secrets (generate with: openssl rand -hex 32)
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# URLs
# FRONTEND_URL: set to your actual Vercel frontend URL in production
FRONTEND_URL="http://localhost:5173"
# BACKEND_URL: used by GitHub OAuth callback redirect
BACKEND_URL="http://localhost:8000"

# Embedding providers (primary: OpenRouter, fallback: Gemini)
# Also used for LLM Generation: openai/gpt-4o-mini (OpenRouter) → google/gemini-2.5-flash (Gemini fallback)
# And for query condensation (conversational RAG): openai/gpt-4o-mini
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# Qdrant Cloud vector database
# Create free cluster at: https://cloud.qdrant.io
QDRANT_URL=""
QDRANT_API_KEY=""

# Inngest background jobs
# Get keys at: https://app.inngest.com
# For local dev leave INNGEST_DEV=1 and start the Inngest Dev Server:
#   npx inngest-cli@latest dev -u http://localhost:8000/api/inngest
# For production set INNGEST_DEV=0 and fill in INNGEST_SIGNING_KEY + INNGEST_EVENT_KEY
INNGEST_DEV="1"
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# Vercel Cron secret — Vercel sends this as "Authorization: Bearer <value>"
# Generate: openssl rand -hex 16
# Set in Vercel dashboard → Settings → Environment Variables
# Set the same value in vercel.json crons configuration (automatically injected by Vercel)
CRON_SECRET=""
